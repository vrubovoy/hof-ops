{
  "name": "hof-ops",
  "version": "0.1.0",
  "description": "Deployment contracts and operations tooling for Hof",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "hofctl": "scripts/hofctl.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate-contracts.mjs",
    "test": "node --test test/*.test.mjs",
    "test:ssh": "node test/ssh-acceptance.mjs",
    "test:apply-ssh": "node test/apply-acceptance.mjs",
    "render": "node scripts/hofctl.mjs render",
    "build-release-lock": "node scripts/build-release-lock.mjs",
    "integration": "node scripts/integration-matrix.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "yaml": "2.8.1"
  }
}
