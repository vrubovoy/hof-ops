{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hof.dev/schemas/release-lock-v1.schema.json",
  "title": "Hof immutable release lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "release", "minimumHofctlVersion", "catalogDigest", "composeTemplateDigest", "components"],
  "properties": {
    "apiVersion": { "const": "hof.dev/release-lock/v1" },
    "release": { "$ref": "#/$defs/semver" },
    "minimumHofctlVersion": { "$ref": "#/$defs/semver" },
    "catalogDigest": { "$ref": "#/$defs/sha256" },
    "composeTemplateDigest": { "$ref": "#/$defs/sha256" },
    "ansibleEnvironment": { "$ref": "#/$defs/ansibleEnvironmentArtifact" },
    "components": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "image": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+/[a-z0-9_./-]+@sha256:[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "revision", "sourceTag", "image", "signatureIdentity", "signatureOidcIssuer", "provenanceDigest", "sbomDigest"],
      "properties": {
        "source": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" },
        "revision": { "$ref": "#/$defs/commit" },
        "sourceTag": { "type": "string", "pattern": "^v?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "image": { "$ref": "#/$defs/image" },
        "signatureIdentity": { "type": "string", "pattern": "^https://github\\.com/" },
        "signatureOidcIssuer": { "type": "string", "format": "uri", "pattern": "^https://" },
        "provenanceDigest": { "$ref": "#/$defs/sha256" },
        "sbomDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "ansibleEnvironmentArtifact": {
      "description": "Identical to $defs/artifact, except sourceTag - the Execution Environment versions independently of the platform release inside this SAME repository (see ansible/README.md's own \"Versioning\" section), so its own git tag is ee-vX.Y.Z, never plain vX.Y.Z (which build-release-lock.mjs's own resolveRevision() always uses for every ordinary component) - two different things sharing one repository must never be able to collide on the same git tag. Deliberately a full duplicate of $defs/artifact, not a $ref override (JSON Schema's own $ref inclusion is additive, not an override mechanism - a sibling `properties.sourceTag` next to a $ref to $defs/artifact would require BOTH patterns to match at once, which is never satisfiable).",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "revision", "sourceTag", "image", "signatureIdentity", "signatureOidcIssuer", "provenanceDigest", "sbomDigest"],
      "properties": {
        "source": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" },
        "revision": { "$ref": "#/$defs/commit" },
        "sourceTag": { "type": "string", "pattern": "^ee-v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "image": { "$ref": "#/$defs/image" },
        "signatureIdentity": { "type": "string", "pattern": "^https://github\\.com/" },
        "signatureOidcIssuer": { "type": "string", "format": "uri", "pattern": "^https://" },
        "provenanceDigest": { "$ref": "#/$defs/sha256" },
        "sbomDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "rollbackCompatible"],
      "properties": {
        "from": { "type": "integer", "minimum": 0 },
        "to": { "type": "integer", "minimum": 0 },
        "rollbackCompatible": { "type": "boolean" }
      }
    },
    "thirdPartyTrust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "upstream", "limitation"],
      "properties": {
        "policy": { "const": "digest-only" },
        "upstream": { "type": "string", "minLength": 1 },
        "limitation": { "type": "string", "minLength": 1 }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["source", "revision", "sourceTag", "image", "signatureIdentity", "signatureOidcIssuer", "provenanceDigest", "sbomDigest", "configSchema"],
          "properties": { "thirdParty": { "const": false } }
        },
        {
          "required": ["image", "thirdParty", "trust"],
          "properties": {
            "thirdParty": { "const": true },
            "source": false,
            "revision": false,
            "sourceTag": false,
            "signatureIdentity": false,
            "signatureOidcIssuer": false,
            "provenanceDigest": false,
            "sbomDigest": false,
            "configSchema": false,
            "database": false
          }
        }
      ],
      "properties": {
        "source": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" },
        "revision": { "$ref": "#/$defs/commit" },
        "sourceTag": { "type": "string", "pattern": "^v?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "image": { "$ref": "#/$defs/image" },
        "signatureIdentity": { "type": "string", "pattern": "^https://github\\.com/" },
        "signatureOidcIssuer": { "type": "string", "format": "uri", "pattern": "^https://" },
        "provenanceDigest": { "$ref": "#/$defs/sha256" },
        "sbomDigest": { "$ref": "#/$defs/sha256" },
        "configSchema": { "type": "integer", "minimum": 1 },
        "database": { "$ref": "#/$defs/database" },
        "thirdParty": { "type": "boolean", "default": false },
        "trust": { "$ref": "#/$defs/thirdPartyTrust" }
      }
    }
  }
}
