{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hof.dev/schemas/release-lock-v1.schema.json",
  "title": "Hof immutable release lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "release", "minimumHofctlVersion", "catalogDigest", "ansibleEnvironment", "components"],
  "properties": {
    "apiVersion": { "const": "hof.dev/release-lock/v1" },
    "release": { "$ref": "#/$defs/semver" },
    "minimumHofctlVersion": { "$ref": "#/$defs/semver" },
    "catalogDigest": { "$ref": "#/$defs/sha256" },
    "ansibleEnvironment": { "$ref": "#/$defs/artifact" },
    "components": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "image": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+/[a-z0-9_./-]+@sha256:[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "signatureIdentity", "provenanceDigest", "sbomDigest"],
      "properties": {
        "image": { "$ref": "#/$defs/image" },
        "signatureIdentity": { "type": "string", "minLength": 1 },
        "provenanceDigest": { "$ref": "#/$defs/sha256" },
        "sbomDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "rollbackCompatible"],
      "properties": {
        "from": { "type": "integer", "minimum": 0 },
        "to": { "type": "integer", "minimum": 0 },
        "rollbackCompatible": { "type": "boolean" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "revision", "image", "signatureIdentity", "provenanceDigest", "sbomDigest", "configSchema"],
      "properties": {
        "source": { "type": "string", "format": "uri", "pattern": "^https://" },
        "revision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "image": { "$ref": "#/$defs/image" },
        "signatureIdentity": { "type": "string", "minLength": 1 },
        "provenanceDigest": { "$ref": "#/$defs/sha256" },
        "sbomDigest": { "$ref": "#/$defs/sha256" },
        "configSchema": { "type": "integer", "minimum": 1 },
        "database": { "$ref": "#/$defs/database" }
      }
    }
  }
}
