{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hof.dev/schemas/service-catalog-v1.schema.json",
  "title": "Hof service catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "services"],
  "properties": {
    "apiVersion": { "const": "hof.dev/catalog/v1" },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/service" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mandatory", "hostname", "artifacts", "dependsOn", "volumes", "health"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "mandatory": { "type": "boolean" },
        "hostname": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "volumes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["component", "path"],
          "properties": {
            "component": { "$ref": "#/$defs/identifier" },
            "path": { "type": "string", "pattern": "^/" }
          }
        },
        "database": {
          "description": "Present only for services with a persistent, migratable database - lets hofctl plan emit a typed database.migrate operation instead of relying on MIGRATE_ON_STARTUP (see PLATFORM-OPS-PLAN.md's hofctl plan design). command is exact argv for the artifact's own image, not a shell string - Hof's backends don't share one WORKDIR/CMD layout (schlussel's is root-level, every other backend's is backend/-prefixed), so it must be given per service rather than derived.",
          "type": "object",
          "additionalProperties": false,
          "required": ["component", "command", "volume"],
          "properties": {
            "component": { "$ref": "#/$defs/identifier" },
            "command": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "volume": { "$ref": "#/$defs/identifier" }
          }
        }
      }
    }
  }
}
