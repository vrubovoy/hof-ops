#!/usr/bin/env node
// Fake "age" for scripts/recovery-kit.mjs's own tests - answers exactly
// the two invocations createRecoveryKit()/openRecoveryKit() ever make
// (`age -r RECIPIENT` reading stdin plaintext, writing stdout ciphertext;
// `age -d -i IDENTITY_FILE` reading stdin ciphertext, writing stdout
// plaintext), without a real X25519 round trip. Same "verify for real
// once by hand, fake for the fast suite" pattern already used for sops
// (see test/fixtures/secrets-fake-sops's own header comment) and cosign -
// the real `age`/`age-keygen` CLI's own argv shape, stdin/stdout
// streaming behavior, wrong-identity refusal ("no identity matched any
// of the recipients"), and malformed-stream refusal this fixture stands
// in for were independently verified for real (a real age 1.3.2 binary,
// installed and run by hand: encrypt/decrypt round trip, wrong identity,
// garbage input) before this fake was written.
//
// The "encryption" here is deliberately NOT real - a fixed identity file
// in these tests' own fixtures just IS the paired recipient string
// itself (no asymmetric math at all), enough structure to prove hofctl's
// OWN plumbing (which recipient it asked for, whether ciphertext really
// begins with the real age-encryption.org/v1 magic header genuine age
// output always has, that a wrong/missing/malformed identity or stream
// is refused) without re-testing age's own, already-trusted cryptography.
// The magic header itself IS the real one - scripts/backup-flow.mjs's
// own verifyRecoveryKit() checks for it directly against whatever this
// fake produces, exactly as it would against real age output.
const fs = require("node:fs");

const MAGIC = Buffer.from("age-encryption.org/v1\n", "utf8");

function readStdin() {
  const chunks = [];
  return new Promise((resolve, reject) => {
    process.stdin.on("data", (chunk) => chunks.push(chunk));
    process.stdin.on("end", () => resolve(Buffer.concat(chunks)));
    process.stdin.on("error", reject);
  });
}

async function main() {
  const args = process.argv.slice(2);

  if (args[0] === "-r") {
    const recipient = args[1];
    const plaintext = await readStdin();
    const body = JSON.stringify({ __hof_test_fake_age: true, recipient, payload: plaintext.toString("base64") });
    process.stdout.write(Buffer.concat([MAGIC, Buffer.from(body, "utf8")]));
    process.exit(0);
  }

  if (args[0] === "-d") {
    const identityIndex = args.indexOf("-i");
    const identityFile = identityIndex >= 0 ? args[identityIndex + 1] : undefined;
    let identity;
    try {
      identity = fs.readFileSync(identityFile, "utf8").trim();
    } catch {
      process.stderr.write(`age: error: failed to read identity file "${identityFile}"\n`);
      process.exit(1);
    }
    const ciphertext = await readStdin();
    if (!ciphertext.subarray(0, MAGIC.length).equals(MAGIC)) {
      process.stderr.write('age: error: failed to read header: parsing age header: unexpected intro\n');
      process.exit(1);
    }
    let parsed;
    try {
      parsed = JSON.parse(ciphertext.subarray(MAGIC.length).toString("utf8"));
    } catch {
      process.stderr.write("age: error: failed to read header: parsing age header: invalid stanza\n");
      process.exit(1);
    }
    if (!parsed.__hof_test_fake_age || parsed.recipient !== identity) {
      process.stderr.write("age: error: no identity matched any of the recipients\n");
      process.exit(1);
    }
    process.stdout.write(Buffer.from(parsed.payload, "base64"));
    process.exit(0);
  }

  process.stderr.write(`fake age: unrecognized invocation: ${args.join(" ")}\n`);
  process.exit(1);
}

main();
